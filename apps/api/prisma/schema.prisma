generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(uuid()) @db.Uuid
  email    String  @unique
  password String
  googleId String? @unique

  // Profile fields
  firstName      String?
  lastName       String?
  phoneNumber    String?
  profilePicture String?

  emailVerified       Boolean   @default(false)
  verificationCode    String?
  verificationExpiry  DateTime?
  passwordSetRequired Boolean   @default(false)
  loginAttempts       Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  pushToken           String?   @map("push_token")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  userRoles     UserRole[]
  wallet        Wallet?
  driver        Driver?
  host          Host?
  notifications Notification[]
  adminLogs     AdminLog[]
  reviews       Review[]

  @@map("users")
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  name      RoleName   @unique
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String             @map("user_id") @db.Uuid
  roleId     String             @map("role_id") @db.Uuid
  status     VerificationStatus @default(PENDING)
  assignedAt DateTime           @default(now()) @map("assigned_at")
  role       Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @unique @map("user_id") @db.Uuid
  balance      Decimal             @default(0) @db.Decimal(15, 2)
  status       WalletStatus        @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at")
  transactions WalletTransaction[]
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id            String            @id @default(uuid()) @db.Uuid
  walletId      String            @map("wallet_id") @db.Uuid
  type          TransactionType
  source        TransactionSource
  amount        Decimal           @db.Decimal(15, 2)
  referenceId   String?           @map("reference_id") @db.Uuid
  balanceBefore Decimal           @map("balance_before") @db.Decimal(15, 2)
  balanceAfter  Decimal           @map("balance_after") @db.Decimal(15, 2)
  createdAt     DateTime          @default(now()) @map("created_at")
  reservations  Reservation?
  wallet        Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model Driver {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @unique @map("user_id") @db.Uuid
  licenseNumber   String?         @map("license_number")
  licenseImageUrl String?         @map("license_image_url")
  createdAt       DateTime        @default(now()) @map("created_at")
  vehicles        DriverVehicle[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations    Reservation[]

  @@map("drivers")
}

model DriverVehicle {
  id          String       @id @default(uuid()) @db.Uuid
  driverId    String       @map("driver_id") @db.Uuid
  plateNumber String?      @map("plate_number")
  vehicleType VehicleType? @map("vehicle_type")
  brand       String?
  model       String?
  color       String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  driver      Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_vehicles")
}

model Host {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @unique @map("user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parkingLocations ParkingLocation[]

  @@map("hosts")
}

model ParkingLocation {
  id                  String                 @id @default(uuid()) @db.Uuid
  hostId              String                 @map("host_id") @db.Uuid
  title               String
  description         String?
  address             String
  latitude            Decimal                @db.Decimal(10, 7)
  longitude           Decimal                @db.Decimal(10, 7)
  basePricePerHour    Decimal                @map("base_price_per_hour") @db.Decimal(10, 2)
  status              LocationStatus         @default(PENDING)
  totalSlots          Int?                   @map("total_slots")
  availableSlots      Int?                   @map("available_slots")
  isMultiLevel        Boolean                @default(false) @map("is_multi_level")
  numberOfLevels      Int?                   @map("number_of_levels")
  proofOfResidenceUrl String?                @map("proof_of_residence_url")
  openTime            String?                @map("open_time")
  closeTime           String?                @map("close_time")
  is24Hours           Boolean                @default(false) @map("is_24_hours")
  createdAt           DateTime               @default(now()) @map("created_at")
  images              ParkingLocationImage[]
  host                Host                   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  parkingSpaces       ParkingSpace[]

  @@map("parking_locations")
}

model ParkingLocationImage {
  id                String          @id @default(uuid()) @db.Uuid
  parkingLocationId String          @map("parking_location_id") @db.Uuid
  imageUrl          String          @map("image_url")
  isPrimary         Boolean         @default(false) @map("is_primary")
  createdAt         DateTime        @default(now()) @map("created_at")
  parkingLocation   ParkingLocation @relation(fields: [parkingLocationId], references: [id], onDelete: Cascade)

  @@map("parking_location_images")
}

model ParkingSpace {
  id                String          @id @default(uuid()) @db.Uuid
  parkingLocationId String          @map("parking_location_id") @db.Uuid
  slotNumber        Int             @map("slot_number")
  name              String?
  description       String?
  levelNumber       Int?            @map("level_number")
  status            SlotStatus      @default(AVAILABLE)
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  parkingLocation   ParkingLocation @relation(fields: [parkingLocationId], references: [id], onDelete: Cascade)
  reservations      Reservation[]

  @@unique([parkingLocationId, slotNumber])
  @@map("parking_spaces")
}

model Reservation {
  id                  String             @id @default(uuid()) @db.Uuid
  driverId            String             @map("driver_id") @db.Uuid
  parkingSpaceId      String             @map("parking_space_id") @db.Uuid
  vehicleId           String?            @map("vehicle_id") @db.Uuid
  status              ReservationStatus  @default(PENDING)
  qrCode              String?            @map("qr_code")
  qrCodeSecret        String?            @map("qr_code_secret")
  totalAmount         Decimal            @map("total_amount") @db.Decimal(10, 2)
  escrowAmount        Decimal?           @map("escrow_amount") @db.Decimal(10, 2)
  finalAmount         Decimal?           @map("final_amount") @db.Decimal(10, 2)
  overtimeAmount      Decimal?           @map("overtime_amount") @db.Decimal(10, 2)
  arrivalDeadline     DateTime           @map("arrival_deadline")
  sessionStartedAt    DateTime?          @map("session_started_at")
  sessionEndedAt      DateTime?          @map("session_ended_at")
  walletTransactionId String?            @unique @map("wallet_transaction_id") @db.Uuid
  hostPayoutId        String?            @map("host_payout_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at")
  payments            Payment[]
  driver              Driver             @relation(fields: [driverId], references: [id])
  parkingSpace        ParkingSpace       @relation(fields: [parkingSpaceId], references: [id])
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])
  reviews             Review[]

  @@index([parkingSpaceId])
  @@index([qrCode])
  @@map("reservations")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  reservationId  String        @map("reservation_id") @db.Uuid
  amount         Decimal       @db.Decimal(10, 2)
  paymentMethod  String?       @map("payment_method")
  status         PaymentStatus @default(PENDING)
  transactionRef String?       @map("transaction_ref")
  createdAt      DateTime      @default(now()) @map("created_at")
  reservation    Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @map("reservation_id") @db.Uuid
  reviewerId    String      @map("reviewer_id") @db.Uuid
  reviewType    ReviewType  @map("review_type")
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now()) @map("created_at")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reviewer      User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([reservationId, reviewType])
  @@map("reviews")
}

enum ReviewType {
  DRIVER_TO_LOCATION
  HOST_TO_DRIVER
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String
  message   String
  type      NotificationType @default(GENERAL)
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  GENERAL
  BOOKING_COMPLETED
  BOOKING_CANCELLED
  BOOKING_PENDING
  DRIVER_NEARBY
  DRIVER_VERIFIED
  LOCATION_APPROVED
  LOCATION_REJECTED
}

model AdminLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  action    String
  targetId  String?  @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_logs")
}

enum RoleName {
  DRIVER
  HOST
  ADMIN
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionSource {
  TOP_UP
  RESERVATION_PAYMENT
  REFUND
  ADMIN_ADJUSTMENT
  HOST_PAYOUT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum VehicleType {
  CAR
  MOTORCYCLE
  SUV
}

enum LocationStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum SlotStatus {
  AVAILABLE
  OCCUPIED
  DISABLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}
