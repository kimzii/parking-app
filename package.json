{
  "name": "parking-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:start": "docker-compose up -d",
    "db:stop": "docker-compose stop",
    "db:logs": "docker-compose logs -f postgres",
    "db:down": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d",
    "db:shell": "docker exec -it parking-app-db psql -U postgres -d parking_app"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.10",
    "prettier": "^3.7.4",
    "turbo": "^2.7.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "dependencies": {
    "expo": "^54.0.33",
    "helmet": "^8.1.0",
    "nodemailer": "^8.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
